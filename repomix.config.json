{
  "include": [
    "prisma/schema.prisma",
    "src/**/*",
    
    "package.json",
    "tsconfig.json"
  ],
  "ignore": {
    "useGitignore": true,
    "customPatterns": [
      "**/*.spec.ts",
      "**/*.e2e-spec.ts",
      "**/node_modules/**",
      "dist/**",
      "test/**/*"
    ]
  },
  "output": {
    "filePath": "repomix-backend-context.txt",
    "style": "markdown"
  }
}