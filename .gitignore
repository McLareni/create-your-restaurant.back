# # # ==============================================================================
# # # GUSTIO BACKEND - STRICT WHITELIST GITIGNORE
# # # Тільки папка персоналу, базові файли NestJS та Prisma
# # # ==============================================================================

# # # 1. Загальне блокування: Ігнорувати абсолютно все в корені проєкту
# /*

# # # 2. Дозволити кореневу папку Prisma та весь її вміст (схеми, міграції)
# !/prisma/

# # # # 3. Дозволити папку src для подальшої фільтрації файлів
# !/src/

# # # # 4. Заблокувати всі прямі дочірні елементи всередині src за замовчуванням
# /src/*

# # # # 5. СТРОГИЙ ВИЙНЯТОК: Дозволити базові системні файли NestJS у папці src
# !/src/main.ts
# !/src/swagger.ts
# !/src/app.module.ts
# !/src/app.service.ts
# !/src/app.controller.ts

# # # # 6. СТРОГИЙ ВИЙНЯТОК: Повністю дозволити папку персоналу (staff) та весь її вміст
# !/src/staff/
# !/src/staff/**

# # # # ==============================================================================
# # # # Додаткові системні винятки (за потреби розкоментуйте для збереження структури)
# # # # ==============================================================================
# !/.gitignore
# !/package.json
# !/tsconfig.json

# src/analytics/
# src/live-monitor/
# src/pos/
# src/staff/
# src/tables/
