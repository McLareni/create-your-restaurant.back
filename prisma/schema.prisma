generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int          @id @default(autoincrement())
  email              String
  firstName          String?
  lastName           String?
  photo              String?
  phone              String?
  role               EnumRole     @default(STAFF)
  customRole         String?      
  pinCode            String?
  restaurantId       Int?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  orders             Order[]      @relation("WaiterOrders")
  sessions           Session[]
  restaurants        Restaurant[] @relation("RestaurantOwner")
  staffRestaurant    Restaurant?  @relation("RestaurantStaff", fields: [restaurantId], references: [id], onDelete: Cascade)
  loginCodeHash      String?
  loginCodeExpiresAt DateTime?

  @@unique([email, restaurantId])
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id                  Int                  @id @default(autoincrement())
  title               String
  slug                String               @unique
  type                EnumTypeRestaurant
  currency            EnumCurrency
  phoneNumber         String?
  city                String?
  street              String?
  building            String?
  workDays            String[]             @default(["mon", "tue", "wed", "thu", "fri", "sat", "sun"])
  workHoursStart      String?              @default("10:00")
  workHoursEnd        String?              @default("22:00")
  instagram           String?
  facebook            String?
  telegram            String?
  tiktok              String?
  imageUrl            String?
  language            EnumLanguage
  ownerId             Int
  purchasedModules    String[]             @default(["menu-engine", "qr-tables", "staff"])
  activeModules       String[]             @default(["menu-engine", "qr-tables", "staff"])
  posIntegration      PosIntegration?
  categories          Category[]
  DiningTable         DiningTable[]
  modifierGroups      ModifierGroup[]
  combos              Combo[]
  owner               User                 @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff               User[]               @relation("RestaurantStaff")
  staffRoles          StaffRole[]
  orders              Order[]
  dishTagLookups      DishTagLookup[]
  dishAllergenLookups DishAllergenLookup[]
  inventoryItems      InventoryItem[]
}

model PosIntegration {
  id           String     @id @default(uuid())
  restaurantId Int        @unique
  provider     String     @default("POSTER")
  apiKey       String
  importMenu   Boolean    @default(true)
  syncStops    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id               String           @id @default(uuid())
  restaurantId     Int
  name             String
  stock            Float            @default(0)
  unit             String
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ingredientDishes DishIngredient[]

  @@unique([restaurantId, name])
}

model DishIngredient {
  id              String         @id @default(uuid())
  dishId          String
  inventoryItemId String?
  name            String
  quantity        Float
  unit            String
  dish            Dish           @relation(fields: [dishId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
}

model DishTagLookup {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]     @relation("DishTagLookup")

  @@unique([restaurantId, name])
}

model DishAllergenLookup {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]     @relation("DishAllergenLookup")

  @@unique([restaurantId, name])
}

model Image {
  id          String      @id @default(uuid())
  url         String
  createdAt   DateTime    @default(now())
  imageDishes ImageDish[]
}

model ImageDish {
  id      String @id @default(uuid())
  dishId  String
  imageId String
  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(uuid())
  restaurantId Int
  name         String
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]
}

model Dish {
  id            String               @id @default(uuid())
  categoryId    String
  name          String
  description   String?
  price         Float
  weight        Float?
  cookingTime   Int?
  calories      Int?
  isVegan       Boolean              @default(false)
  isSpicy       Boolean              @default(false)
  isLactoseFree Boolean              @default(false)
  badge         BadgeType            @default(NONE)
  allergens     DishAllergenLookup[] @relation("DishAllergenLookup")
  tags          DishTagLookup[]      @relation("DishTagLookup")
  isAvailable   Boolean              @default(true)
  sortOrder     Int                  @default(0)
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifiers     DishModifier[]
  images        ImageDish[]
  ingredients   DishIngredient[]
  orderItems    OrderItem[]
  comboDishes   ComboDish[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @default(now()) @updatedAt
}

model Combo {
  id           String         @id @default(uuid())
  restaurantId Int
  name         String
  priceType    ComboPriceType
  priceValue   Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       ComboDish[]
}

model ComboDish {
  id      String @id @default(uuid())
  comboId String
  dishId  String
  combo   Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)
  dish    Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
}

model StaffRole {
  id           String     @id @default(uuid())
  restaurantId Int
  name         String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
}

model ModifierGroup {
  id            String           @id @default(uuid())
  restaurantId  Int
  name          String
  isRequired    Boolean          @default(false)
  minSelections Int              @default(0)
  maxSelections Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  dishes        DishModifier[]
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options       ModifierOption[]
}

model ModifierOption {
  id                 String              @id @default(uuid())
  modifierGroupId    String
  name               String
  price              Float               @default(0)
  isAvailable        Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  group              ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]
}

model DishModifier {
  dishId          String
  modifierGroupId String
  dish            Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([dishId, modifierGroupId])
}

model DiningTable {
  id           String      @id @default(uuid())
  number       Int
  type         String
  zone         String?
  status       TableStatus @default(INACTIVE)
  isWaiterCallActive Boolean   @default(false)
  waiterCallRequestedAt DateTime?
  restaurantId Int
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([number, restaurantId])
}

model Order {
  id           String       @id @default(uuid())
  restaurantId Int
  tableId      String?
  type         OrderType    @default(DINE_IN)
  status       OrderStatus  @default(PENDING)
  totalAmount  Float        @default(0.0)
  waiterId     Int?
  waiter       User?        @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        OrderItem[]
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        DiningTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([tableId])
}

model OrderItem {
  id        String              @id @default(uuid())
  orderId   String
  dishId    String
  quantity  Int
  unitPrice Float
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish                @relation(fields: [dishId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([dishId])
}

model OrderItemModifier {
  id               String         @id @default(uuid())
  orderItemId      String
  modifierOptionId String
  quantity         Int            @default(1)
  unitPrice        Float
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, modifierOptionId])
  @@index([orderItemId])
  @@index([modifierOptionId])
}

enum EnumRole {
  OWNER
  STAFF
  CUSTOMER
}

enum EnumLanguage {
  EN
  FR
  ES
  DE
  IT
  RU
  CN
  JP
  PL
  UA
}

enum EnumCurrency {
  USD
  EUR
  GBP
  JPY
  CNY
  RUB
  PLN
  UAH
}

enum EnumTypeRestaurant {
  FAST_FOOD
  CASUAL_DINING
  FINE_DINING
  CAFE
  BUFFET
  FOOD_TRUCK
}

enum BadgeType {
  NONE
  NEW
  HIT
  CHEF_CHOICE
  TOP_RATED
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  COMPLETED
  CANCELED
}

enum ComboPriceType {
  FIXED
  DISCOUNT
}
